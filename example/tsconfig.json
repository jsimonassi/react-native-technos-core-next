{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // A biblioteca vive em ".." e não tem node_modules: o import pelo nome do pacote aponta para ../src,
    // e o react-native e o react (os componentes de ../src/components) de ../src resolvem para o node_modules deste
    // exemplo, como no tsconfig da raiz.
    "paths": {
      "react-native-technos-core-next": ["../src/index.ts"],
      "react-native-technos-core-next/*": ["../*"],
      "react-native": ["./node_modules/react-native"],
      "react": ["./node_modules/@types/react"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "android", "ios"]
}
